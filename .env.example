# Kairo configuration (copy to .env)

# Project & security
PROJECT_NAME=Kairo
VERSION=1.0.0
# 64 hex chars, AES-256-GCM key for stored channel credentials — generate your own
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (PostgreSQL 16 + pgvector); SQLite is used when Postgres is unreachable
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kairo
POSTGRES_PASSWORD=kairo_secret
POSTGRES_DB=kairo
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=data/kairo.db

# Publish queue (the posts table) and policy state
RUN_SCHEDULER_IN_API=True          # docker-compose sets False: the publisher service publishes
SCHEDULER_INTERVAL_SECONDS=30
PUBLISH_BATCH_SIZE=20
PUBLISH_CONCURRENCY=8
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_RETRY_BASE_SECONDS=30      # retries after 30 s, 60 s, 120 s
PUBLISH_CLAIM_TIMEOUT_SECONDS=600  # a claimed post returns to the queue after this
BANDIT_STATE_TTL_SECONDS=30
TELEMETRY_POLL_SECONDS=300

# Public URL of the frontend (Instagram and TikTok fetch media by URL)
PUBLIC_BASE_URL=

# LLM inference (primary: local LM Studio)
# From a Docker container on Windows/macOS use http://host.docker.internal:1234/v1
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_NAME=ternary-bonsai-27b
LLM_EMBEDDING_MODEL=nomic-embed-text-v1.5
LLM_TIMEOUT_SECONDS=180
LLM_PREFLIGHT_SECONDS=20

# Cloud fallback (optional; also a bandit arm with a cost penalty)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=moonshotai/kimi-k2.6
COST_AWARE_LAMBDA=0.05

# Channels pre-connected on first start (others: Channels tab in the UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# Image & video
IMAGE_MODEL_NAME=prism-ml/bonsai-image-ternary-4B-gemlite-2bit
TTS_SERVICE_URL=http://localhost:8001
FFMPEG_BINARY=ffmpeg

# Storage paths
DATA_ARCHIVE_PATH=data/archive
DATA_MEDIA_PATH=data/media
