# Вебінтерфейс і API-шлюз Kairo: кожен префікс /api/v1/* іде у свій сервіс.

# WebSocket (живий перебіг експерименту в Content) — заголовки оновлення з'єднання
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # DNS оркестратора (Docker — 127.0.0.11, Kubernetes — kube-dns). Без нього nginx
    # резолвить адресу сервісу один раз під час старту й тримає її вічно: після
    # перезапуску контейнера шлюз повертав би 502. Через змінну в proxy_pass запити
    # розподіляються між репліками сервісу. KAIRO_* підставляє nginx із оточення.
    resolver ${KAIRO_RESOLVER} valid=10s ipv6=off;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Офлайн-симуляція політик і генерація рахуються довше за типовий веб-запит
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Внутрішні маршрути (/…/internal/…) — лише для викликів між сервісами
    location ~ ^/api/v1/[^/]+/internal/ {
        return 404;
    }

    # Збір лічильників і можливості мереж — у Publishing (там адаптери й облікові дані)
    location ~ ^/api/v1/telemetry/(collect|capabilities)$ {
        set $upstream publishing${KAIRO_SVC_SUFFIX}:8000;
        proxy_pass http://$upstream$request_uri;
    }

    location ~ ^/api/v1/(content|audience|experiments)(/|$) {
        set $upstream content${KAIRO_SVC_SUFFIX}:8000;
        proxy_pass http://$upstream$request_uri;
    }

    location ~ ^/api/v1/schedule(/|$) {
        set $upstream scheduler${KAIRO_SVC_SUFFIX}:8000;
        proxy_pass http://$upstream$request_uri;
    }

    location ~ ^/api/v1/(platforms|accounts)(/|$) {
        set $upstream publishing${KAIRO_SVC_SUFFIX}:8000;
        proxy_pass http://$upstream$request_uri;
    }

    location ~ ^/api/v1/(telemetry|dashboard|logs)(/|$) {
        set $upstream telemetry${KAIRO_SVC_SUFFIX}:8000;
        proxy_pass http://$upstream$request_uri;
    }

    location ~ ^/api/v1/demand(/|$) {
        set $upstream trends${KAIRO_SVC_SUFFIX}:8000;
        proxy_pass http://$upstream$request_uri;
    }

    location ~ ^/api/v1/media(/|$) {
        set $upstream media${KAIRO_SVC_SUFFIX}:8000;
        proxy_pass http://$upstream$request_uri;
    }

    # Згенеровані ілюстрації й відео
    location /media/ {
        set $upstream media${KAIRO_SVC_SUFFIX}:8000;
        proxy_pass http://$upstream$request_uri;
    }
}
